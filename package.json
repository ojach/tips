{
  "name": "ojapp-blog-kit",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A lightweight static blog engine for your own domain.",
  "scripts": {
  "build": "node scripts/build.js",
  "deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy.ps1",
  "push": "npm run build && npm run deploy"
},
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "marked": "^17.0.5",
    "sharp": "^0.35.4",
    "shiki": "^4.5.0"
  },
  "devDependencies": {
    "wrangler": "^4.156.0"
  }
}
